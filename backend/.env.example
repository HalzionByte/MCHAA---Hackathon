PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./crop_health.db

# AI & LLM Service Keys (Gemini required for image analysis; Claude optional for advanced diagnosis)
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Agromonitoring API (free tier; required for live soil moisture + NDVI satellite data)
AGROMONITORING_API_KEY=your_agromonitoring_api_key_here

# Anomaly detection mode: "auto" = live data decision, "force" = always flag water_stress
ANOMALY_MODE=auto
